# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=

# Read the current limits for openai/gpt-oss-120b from https://console.groq.com/settings/limits
# (do not trust defaults; the docs page shows Developer-plan numbers).
RPM_LIMIT=
TPM_LIMIT=
DAILY_TOKEN_BUDGET=

# Optional overrides
# QSR_MODEL=openai/gpt-oss-120b
# QSR_TEMPERATURE=0
# QSR_REASONING_EFFORT=low   (default; the reported results use low)
# QSR_MAX_COMPLETION_TOKENS=4096
# QSR_EXEC_TIMEOUT_S=60
